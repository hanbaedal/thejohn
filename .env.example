# MongoDB Atlas (비밀번호는 Atlas에서 재발급 후 입력)
# Render 권장: URI 대신 분리 (비밀번호 ! 등 안전)
MONGODB_USER=thejohn_db_user
MONGODB_PASSWORD=your-atlas-password
MONGODB_HOST=cluster0.xxxxx.mongodb.net
MONGODB_DB=thejhon

# 또는 한 줄 URI
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# 서버
PORT=3000
JWT_SECRET=여기에_32자_이상_랜덤_문자열

# 관리자 시드 비밀번호 (브라우저·프론트에 두지 않음, staff 컬렉션)
THEJHON_SEED_SUPERVISOR_PASSWORD=supervisor-password-for-thejhon
THEJHON_ADMIN_PASSWORD=legacy-admin-fallback-optional

# CORS (쉼표 구분, 비우면 동일 출처만 사용 시 생략 가능)
ALLOWED_ORIGINS=https://thejohn.co.kr,https://www.thejohn.co.kr,http://localhost:3000

# 업체 주문 알림 (Twilio SMS) — 미설정 시 주문은 저장·PDF만, 문자는 건너뜀
# 담당 관리자 staff.st_ceo_tel 우선 (aksangsa 대표 연락처), 없으면 ORDER_NOTIFY_PHONE
ORDER_NOTIFY_PHONE=01047212333
ORDER_NOTIFY_STAFF_ID=aksangsa
# 알림 방식: sms(기본, 간단 문자) | full(상세 문자) | sms_link(문자+PDF링크) | mms(PDF MMS)
ORDER_NOTIFY_MODE=sms
# sms_link / mms 일 때만 필요
PUBLIC_BASE_URL=https://thejohn.co.kr
# 주문·장바구니 허용 업체 등록 담당 (vn_registered_by 와 일치해야 함)
ORDER_VENDOR_STAFF_ID=aksangsa
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 서버 PDF 한글 폰트 (선택, Linux 배포 시 권장)
# PDF_FONT_PATH=/path/to/NotoSansKR-Regular.otf
